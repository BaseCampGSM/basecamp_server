# EC2 배포 서버에 실제 값으로 채운 .env 파일을 만들 때 참고용 템플릿.
# (docker-compose.yml 과 같은 디렉토리 = /home/ubuntu/basecamp/.env 에 위치)
# ⚠️ 값은 절대 git 에 커밋하지 말 것. 이 파일은 이름만 보여주는 예시.

# Supabase (PostgreSQL)
SUPABASE_DB_HOST=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 외부 API
ANTHROPIC_API_KEY=
PUBLIC_DATA_API_KEY=
LOCAL_DATA_API_KEY=
KAKAO_REST_API_KEY=
