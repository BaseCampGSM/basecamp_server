# Caddy 리버스 프록시 설정.
# 도메인으로 들어오는 HTTPS 요청을 경로에 따라 내부 컨테이너로 전달한다.
# Caddy 가 Let's Encrypt 인증서를 자동 발급/갱신하므로 HTTPS 는 자동으로 붙는다.
#
# 전제조건: DNS A레코드가 EC2 IP 를 가리키고, 보안그룹 80/443 이 열려 있을 것.

basecamp-imsi.p-e.kr {
    # AI 서버(FastAPI, Bedrock) — 프론트가 https://.../api/ai/solve-issue 로 호출
    handle /api/ai/* {
        reverse_proxy fastapi-ai:8001
    }

    # 그 외 모든 경로 → Spring 백엔드
    handle {
        reverse_proxy basecamp-server:8080
    }
}
