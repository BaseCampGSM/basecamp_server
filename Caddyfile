# Caddy 리버스 프록시 설정.
# 이 도메인으로 들어오는 HTTPS 요청을 내부 basecamp-server(8080)로 전달한다.
# Caddy 가 Let's Encrypt 인증서를 자동 발급/갱신하므로 HTTPS 는 자동으로 붙는다.
#
# 전제조건(둘 다 충족돼야 인증서 발급됨):
#  1) 이 도메인의 DNS A 레코드가 EC2 퍼블릭 IP 를 가리킬 것
#  2) 보안그룹에서 80, 443 포트가 열려 있을 것
#
basecamp-imsi.p-e.kr {
    reverse_proxy basecamp-server:8080
}
